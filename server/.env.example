# ===== riben-server 配置（环境变量优先） =====

# 服务监听
HOST=0.0.0.0
PORT=9015

# MySQL（utf8mb4；启动时自动执行 server/migrations/ 下的 migration）
DATABASE_URL=mysql://riben:riben@127.0.0.1:3306/riben

# Redis（缓存 + Session + 限流；不可用时服务降级，不中断）
# 标准 Redis URL 格式：
#   无认证:                     redis://127.0.0.1:6379
#   仅密码（旧版）:             redis://:password@127.0.0.1:6379
#   用户名+密码（Redis 6+ ACL）: redis://user:password@127.0.0.1:6379
# 可选库编号：末尾加 /0、/1 等；启用 TLS 时 scheme 用 rediss://
# 注意：用户名/密码含特殊字符需 URL 编码，如 @ → %40，/ → %2F，: → %3A
REDIS_URL=redis://127.0.0.1:6379

# Session 有效期（天），滑动续期
SESSION_TTL_DAYS=7

# HTTPS 部署（Caddy/Nginx 终止 TLS）时置 1，Cookie 加 Secure
COOKIE_SECURE=false

# 由 Rust 服务直接托管前端静态资源时填写前端目录（相对 server/ 或绝对路径）；
# 若由 Caddy/Nginx 托管 frontend/，留空即可
FRONTEND_DIR=../frontend

# 首次启动且 users 表为空时播种管理员（仅限首次，之后请登录后台或改库）
# 邮箱验证码登录：管理员邮箱，用于接收登录验证码
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com

# 可选：管理员 API Token。配置后请求头 `x-admin-token: <token>`（或
# `Authorization: Bearer <token>`）携带该值即可绕过登录鉴权，以管理员身份
# 调用全部管理接口（不依赖 Redis 会话）。MCP 请求头鉴权同样使用该 token。
# 务必使用足够随机的长 token，生产环境请通过流水线 Secret 注入，
# 切勿提交到仓库；不配置则关闭该能力
#ADMIN_API_TOKEN=请替换为足够随机的长字符串

# ===== MCP 服务（Streamable HTTP，挂载在 /mcp） =====
# 是否启用 MCP 服务；默认 true
MCP_ENABLED=true
# 允许的 Host 头（逗号分隔，防 DNS rebinding）。默认已包含
# localhost / 127.0.0.1 / ::1；生产环境必须追加站点域名。
# 设为 * 表示关闭 Host 校验（仅限内网调试，不推荐）
MCP_ALLOWED_HOSTS=riben.icu
# 允许的浏览器 Origin（逗号分隔，可选）。留空表示不校验 Origin
#MCP_ALLOWED_ORIGINS=https://riben.icu

# SMTP 邮件发送（邮箱验证码登录必需）
# 支持 Gmail / QQ邮箱 / 163 等，注意端口与加密方式：
#   - SMTPS (SSL): SMTP_PORT=465, SMTP_SECURE=true
#   - STARTTLS:    SMTP_PORT=587, SMTP_SECURE=false
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
# 发件人地址，不填则与 SMTP_USER 相同
SMTP_FROM=noreply@example.com

# 首次启动且 posts 表为空时写入 6 篇演示文章（原静态站内容）；false 关闭
SEED_DEMO=true

# 日志
RUST_LOG=riben_server=info,tower_http=info,sqlx=warn
