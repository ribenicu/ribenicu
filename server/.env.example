# ===== riben-server 配置（环境变量优先） =====

# 服务监听
HOST=0.0.0.0
PORT=9015

# MySQL（utf8mb4；启动时自动执行 server/migrations/ 下的 migration）
DATABASE_URL=mysql://riben:riben@127.0.0.1:3306/riben

# Redis（缓存 + Session + 限流；不可用时服务降级，不中断）
# 标准 Redis URL 格式：
#   无认证:                     redis://127.0.0.1:6379
#   仅密码（旧版）:             redis://:password@127.0.0.1:6379
#   用户名+密码（Redis 6+ ACL）: redis://user:password@127.0.0.1:6379
# 可选库编号：末尾加 /0、/1 等；启用 TLS 时 scheme 用 rediss://
# 注意：用户名/密码含特殊字符需 URL 编码，如 @ → %40，/ → %2F，: → %3A
REDIS_URL=redis://127.0.0.1:6379

# Session 有效期（天），滑动续期
SESSION_TTL_DAYS=7

# HTTPS 部署（Caddy/Nginx 终止 TLS）时置 1，Cookie 加 Secure
COOKIE_SECURE=false

# 由 Rust 服务直接托管前端静态资源时填写前端目录（相对 server/ 或绝对路径）；
# 若由 Caddy/Nginx 托管 frontend/，留空即可
FRONTEND_DIR=../frontend

# 首次启动且 users 表为空时播种管理员（仅限首次，之后请登录后台或改库）
# 邮箱验证码登录：管理员邮箱，用于接收登录验证码
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com

# SMTP 邮件发送（邮箱验证码登录必需）
# 支持 Gmail / QQ邮箱 / 163 等，注意端口与加密方式：
#   - SMTPS (SSL): SMTP_PORT=465, SMTP_SECURE=true
#   - STARTTLS:    SMTP_PORT=587, SMTP_SECURE=false
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
# 发件人地址，不填则与 SMTP_USER 相同
SMTP_FROM=noreply@example.com

# 首次启动且 posts 表为空时写入 6 篇演示文章（原静态站内容）；false 关闭
SEED_DEMO=true

# 日志
RUST_LOG=riben_server=info,tower_http=info,sqlx=warn
