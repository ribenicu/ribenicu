# deploy/.env 示例：cp 为 deploy/.env 后修改

# MySQL
MYSQL_DATABASE=riben
MYSQL_USER=riben
MYSQL_PASSWORD=change-me-strong-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# 首次启动播种的管理员（之后可改库或重建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# 首次启动且文章表为空时写入演示文章
SEED_DEMO=true

# 站点地址（Caddy 自动申请 TLS；本地联调可改为 :80 或 localhost）
SITE_ADDRESS=riben.icu
