# deploy/.env 示例：cp 为 deploy/.env 后修改

# MySQL
MYSQL_DATABASE=riben
MYSQL_USER=riben
MYSQL_PASSWORD=change-me-strong-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# 首次启动播种的管理员（之后可改库或重建）
# 登录方式为邮箱验证码，ADMIN_EMAIL 必填且需能收信
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com

# 管理员 token 旁路鉴权（请求头 x-admin-token / Bearer，智能体自动化用）
# 留空则旁路不生效；请替换为足够随机的长字符串（如 openssl rand -hex 32）
#ADMIN_API_TOKEN=change-me-random-long-string

# 首次启动且文章表为空时写入演示文章
SEED_DEMO=true

# 站点地址（Caddy 自动申请 TLS；本地联调可改为 :80 或 localhost）
SITE_ADDRESS=riben.icu

# MCP 服务（https://<SITE_ADDRESS>/mcp）
MCP_ENABLED=true
# 允许的 Host 头（防 DNS rebinding），默认已含 localhost/127.0.0.1
MCP_ALLOWED_HOSTS=riben.icu,localhost,127.0.0.1
